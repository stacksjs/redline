# Deployment credentials for `bun run deploy` (ts-cloud).
# Copy to `.env` and fill in. `.env` is git-ignored.

# ---- Hetzner ----------------------------------------------------------------
# The site rides the Stacks box (`cloud.attachTo: 'stacks'`), so this only needs
# read access to the same Hetzner project to resolve that server by its labels.
# Same value as ~/Code/stacks/.env
HCLOUD_TOKEN=

# ---- Cloudflare -------------------------------------------------------------
# Custom API token, scoped to the redlinemarketingagency.com zone only.
# Create at https://dash.cloudflare.com/profile/api-tokens → Create Custom Token
#
#   Permissions (all at Zone level):
#     Zone   → DNS              → Edit    (proxied A/AAAA records)
#     Zone   → Zone             → Read    (resolve the zone, read its settings)
#     Zone   → Zone Settings    → Edit    (SSL mode, HSTS, Brotli, HTTP/3, min TLS)
#     Zone   → Cache Purge      → Purge   (purge the edge cache after a deploy)
#     Zone   → Cache Rules      → Edit    (per-extension edge/browser TTLs)
#     Zone   → Transform Rules  → Edit    (only if the origin-guard secret is enabled)
#
#   Zone Resources: Include → Specific zone → redlinemarketingagency.com
CLOUDFLARE_API_TOKEN=

# Zone and account ids are NOT secret and already live in cloud.config.ts.
# Set them here only to override that file.
# CLOUDFLARE_ZONE_ID=05de3495b3f99e5219710287d191e06b
# CLOUDFLARE_ACCOUNT_ID=6ec9332b06d4795b12d2d08a9e5c75c8

# Optional: origin lockdown. See the `secret` note in cloud.config.ts before
# enabling — rpx enforces one secret per gateway and the box is shared.
# CLOUDFLARE_ORIGIN_SECRET=

# ---- Push to deploy ---------------------------------------------------------
# Every push to main deploys via .github/workflows/deploy.yml, which reads the
# same credentials from repository secrets instead of this file:
#
#   HCLOUD_TOKEN           same Hetzner token as above
#   CLOUDFLARE_API_TOKEN   same zone-scoped Cloudflare token as above
#   HCLOUD_SSH_KEY         private half of the redline-github-actions ed25519
#                          key; its public half is in the box's authorized_keys
#
# The workflow skips (green, with a notice) if any of the three is missing, so
# it never fails for want of configuration.
#
# Rotating the SSH key: ssh-keygen a new pair, append the public half to
# root@178.105.248.188:~/.ssh/authorized_keys, update the secret, then remove
# the old line from authorized_keys.
